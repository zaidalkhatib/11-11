# Firebase web/client config (Project settings → Your apps).
# Copy to .env for local Expo. Safe to embed in the client; restrict the API key in Google Cloud.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# API (local-dev default). Production: your Railway HTTPS URL.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
